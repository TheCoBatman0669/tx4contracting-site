# Copy to .env.local for local development, and set the same values in
# Netlify under Site settings -> Environment variables.
#
# NEXT_PUBLIC_ values are visible in the browser bundle. Never put a secret
# key here. Service-role and Turnstile secret keys belong in the Supabase
# edge function environment only (Phase 5).

# Supabase project the forms submit through
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public half of the pair).
# Leave blank in development to use Cloudflare's always-passes test key.
# Required before launch: without it, bot protection is not active.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
